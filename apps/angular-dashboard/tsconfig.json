/* Shared TypeScript settings for the Angular app (strict, extends the monorepo base). */
/* Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options */
{
  "extends": "@portfolio/config/tsconfig.base.json",
  "compileOnSave": false,
  "compilerOptions": {
    "noEmit": false,
    "verbatimModuleSyntax": false,
    "noPropertyAccessFromIndexSignature": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    // Compile the shared theme module as app source. Without this, the Angular
    // dev server treats the workspace package as a prebuilt dependency and
    // serves its raw TypeScript to the browser ("Unexpected token 'export'").
    "paths": {
      "@portfolio/design-tokens/theme": ["../../packages/design-tokens/src/theme.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "strictStandalone": true
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.spec.json" }]
}
