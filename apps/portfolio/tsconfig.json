{
  "extends": "@portfolio/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": false,
    "jsx": "react-jsx",
    "incremental": true,
    // Next.js type-checks its own generated files in .next/ (which contain unused
    // imports). Unused code in *our* files is still an error via ESLint
    // (@typescript-eslint/no-unused-vars), so these two compiler checks are off here.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out"]
}
