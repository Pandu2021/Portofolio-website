{
  "name": "@portfolio/design-tokens",
  "version": "1.0.0",
  "private": true,
  "description": "Shared design tokens (colors, type, spacing, motion), self-hosted fonts and base styles for every app.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./base.css": "./src/base.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@fontsource-variable/plus-jakarta-sans": "catalog:"
  },
  "devDependencies": {
    "@portfolio/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
