# =============================================================================
# .gitattributes — consistent line endings across Windows/macOS/Linux.
# Text files are stored with LF in the repository; binaries are never touched.
# =============================================================================
* text=auto eol=lf

# Shell scripts and git hooks must keep LF or they fail on Linux CI runners.
*.sh        text eol=lf
.githooks/* text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
